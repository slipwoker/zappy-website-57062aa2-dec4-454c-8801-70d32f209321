# Clean URL redirects for Render static hosting
# These rewrite rules show clean URLs to users while serving .html files

/about  /about.html  200
/contact  /contact.html  200
/gallery  /gallery.html  200
/process  /process.html  200

# Language slug rewrites for SEO
/en/about  /en/about.html  200
/en/contact  /en/contact.html  200
/en/gallery  /en/gallery.html  200
/en  /en/index.html  200
/en/process  /en/process.html  200
/en  /en/index.html  200

# Legal pages - redirect old .html URLs to friendly URLs
/privacy.html  /privacy  301
/accessibility.html  /accessibility  301
/terms.html  /terms  301

/  /index.html  200

# 404 fallback
/*  /index.html  404
